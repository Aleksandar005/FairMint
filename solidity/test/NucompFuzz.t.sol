    function F2_11() internal pure returns (CG.Form memory){return CG.Form(F2_11_a(),F2_11_b(),F2_11_c());}
    function R_11() internal pure returns (CG.Form memory){return CG.Form(R_11_a(),R_11_b(),R_11_c());}
    function test_NucompDiffAll() public view {
        B.Int memory d=D();
        assertTrue(CG.eq(CG.nucomp(F1_0(),F2_0(),d), R_0()), "vec 0 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_1(),F2_1(),d), R_1()), "vec 1 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_2(),F2_2(),d), R_2()), "vec 2 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_3(),F2_3(),d), R_3()), "vec 3 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_4(),F2_4(),d), R_4()), "vec 4 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_5(),F2_5(),d), R_5()), "vec 5 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_6(),F2_6(),d), R_6()), "vec 6 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_7(),F2_7(),d), R_7()), "vec 7 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_8(),F2_8(),d), R_8()), "vec 8 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_9(),F2_9(),d), R_9()), "vec 9 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_10(),F2_10(),d), R_10()), "vec 10 nucomp!=compose");
        assertTrue(CG.eq(CG.nucomp(F1_11(),F2_11(),d), R_11()), "vec 11 nucomp!=compose");
    }
    function test_NucompEqualFallsBackToSquare() public view {
        B.Int memory d=D();
        assertTrue(CG.eq(CG.nucomp(F1_0(),F1_0(),d), CG.square(F1_0(),d)), "nucomp(f,f)!=square");
